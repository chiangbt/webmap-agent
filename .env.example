# Copy this file to .env and fill in the values for local development.
#
# Google Cloud OAuth 2.0 Client ID for a Web application.
# Add your local/dev origin, for example: http://localhost:5173
VITE_GEE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional default Google Cloud project ID with Earth Engine enabled.
# If omitted, users can enter their own project ID in the GeoAgent panel.
VITE_GEE_PROJECT_ID=

# Optional default LLM endpoint for the GeoAgent panel (deployment defaults).
# Prefills the panel's provider settings (openai-compatible expects an
# OpenAI-style base URL such as https://host/v1); values saved in the panel
# (sessionStorage) take precedence over these.
#
# NOTE: never put real credentials in this file — it is tracked by git and
# ships to every clone. Real deployment values belong in the gitignored .env.
LLM_API_URL=https://your-llm-endpoint.example.com/compatible-mode/v1
LLM_API_KEY=sk-your-api-key
LLM_API_MODEL=qwen3.8-flash